{
    "name": "cloud-mail",
    "main": "src/index.js",
    "compatibility_date": "2025-06-04",
    "keep_vars": true,
    "observability": {
        "enabled": true
    },
    // D1 数据库绑定 - 部署时会自动创建
    "d1_databases": [
        {
            "binding": "db",
            "database_name": "cloud-mail-db"
        }
    ],
    // KV 命名空间绑定 - 部署时会自动创建
    "kv_namespaces": [
        {
            "binding": "kv"
        }
    ],
    // 静态资源配置
    "assets": {
        "binding": "assets",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
    },
    // 定时任务
    "triggers": {
        "crons": [
            "0 16 * * *"
        ]
    },
    // 环境变量 - 部署时需要配置
    "vars": {
        "domain": "example.com",
        "admin": "admin@example.com",
        "jwt_secret": "change-me-to-random-string"
    },
    // 构建命令
    "build": {
        "command": "pnpm --prefix ../mail-vue install && pnpm --prefix ../mail-vue run build"
    }
}